# Copy to .env (never commit the real file) or export these variables before `python app.py`.
HOST=0.0.0.0
PORT=5000
# 1 enables the Flask debugger; keep 0 outside local development.
FLASK_DEBUG=0
LOG_LEVEL=INFO
# Without SECRET_KEY an ephemeral random key is generated at every boot.
SECRET_KEY=
# Default: sqlite:///tasks.db (instance/tasks.db). DATABASE_URL wins over DATABASE_PATH.
DATABASE_URL=
DATABASE_PATH=
