# Copy to your environment (or a local .env loaded by your shell). Never commit real values.
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
DATABASE_PATH=loja.db
APP_ENV=producao
LOG_LEVEL=INFO
# Required in production; an ephemeral value is generated when empty
SECRET_KEY=
# Enables /admin/* (sent as the X-Admin-Token header); admin routes answer 403 when empty
ADMIN_TOKEN=
