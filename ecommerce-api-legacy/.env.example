HOST=0.0.0.0
PORT=3000
# Default is an in-memory database seeded at every boot; set a file path to persist
DATABASE_PATH=:memory:
# Required to call /api/admin/* (header X-Admin-Token); admin routes answer 403 while empty
ADMIN_TOKEN=
PAYMENT_GATEWAY_KEY=
# error | warn | info | silent
LOG_LEVEL=info
